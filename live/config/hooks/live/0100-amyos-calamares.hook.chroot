#!/bin/sh
# Points Debian's Calamares setup at Amy OS and Debian testing.
set -e

helpers=/usr/share/calamares/helpers

sed -i 's/^branding: .*/branding: amyos/' /etc/calamares/settings.conf
grep -qx 'branding: amyos' /etc/calamares/settings.conf

# The package pool on the USB is published as "testing".
sed -i 's/^RELEASE=.*/RELEASE="testing"/' "$helpers/calamares-sources-media"
grep -qx 'RELEASE="testing"' "$helpers/calamares-sources-media"

# Runs last on the installed system: point APT at testing, drop installer files.
cat >"$helpers/calamares-sources-final" <<'EOS'
#!/bin/sh
CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

rm -rf "$CHROOT/etc/apt/sources.list" "$CHROOT/etc/calamares"
cat <<EOF >"$CHROOT/etc/apt/sources.list.d/debian.sources"
Types: deb
URIs: http://deb.debian.org/debian
Suites: testing testing-updates
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp

Types: deb
URIs: http://security.debian.org/debian-security
Suites: testing-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
EOF
EOS

desktop=/usr/share/applications/calamares-install-debian.desktop
sed -i -e 's/^Name=.*/Name=Install Amy OS/' -e 's/^Icon=.*/Icon=amyos/' "$desktop"
grep -qx 'Name=Install Amy OS' "$desktop"
