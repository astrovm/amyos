#!/bin/sh
# Points Debian's Calamares setup at Amy OS and Ubuntu 26.04.
set -e

helpers=/usr/share/calamares/helpers

sed -i 's/^branding: .*/branding: amyos/' /etc/calamares/settings.conf
grep -qx 'branding: amyos' /etc/calamares/settings.conf

# The package pool on the USB is published as "resolute".
sed -i 's/^RELEASE=.*/RELEASE="resolute"/' "$helpers/calamares-sources-media"
grep -qx 'RELEASE="resolute"' "$helpers/calamares-sources-media"

# grub-efi only recommends the signed boot loaders, and the installed system
# skips recommends, so ask for them by name to keep Secure Boot working.
bootloader="$helpers/calamares-bootloader-config"
sed -i "s/apt-get -y install grub-efi\$/apt-get -y install grub-efi grub-efi-$(dpkg --print-architecture)-signed shim-signed/" "$bootloader"
grep -q 'install grub-efi grub-efi-.*-signed shim-signed$' "$bootloader"

# Ubuntu has no live-task packages, and APT stops on names it doesn't know.
packages=/etc/calamares/modules/packages.conf
sed -i '/live-task-/d' "$packages"
if grep -q live-task- "$packages"; then
  echo "Couldn't drop the live-task packages from $packages" >&2
  exit 1
fi

# Ubuntu's Calamares only creates the partitions listed here, and Debian's
# settings list none, so Erase disk made no root partition.
partition=/etc/calamares/modules/partition.conf
if grep -q '^partitionLayout:' "$partition"; then
  echo "Debian's Calamares settings now have a partition layout, check $partition" >&2
  exit 1
fi
cat >>"$partition" <<'EOF'
partitionLayout:
    - name: "root"
      filesystem: unknown
      mountPoint: "/"
      size: 100%
EOF

# Runs last on the installed system: point APT at Ubuntu, drop installer files.
cat >"$helpers/calamares-sources-final" <<'EOS'
#!/bin/sh
CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

# Ubuntu keeps ARM64 on its ports mirror.
if [ "$(dpkg --print-architecture)" = amd64 ]; then
  archive=http://archive.ubuntu.com/ubuntu/
  security=http://security.ubuntu.com/ubuntu/
else
  archive=http://ports.ubuntu.com/ubuntu-ports/
  security=$archive
fi

rm -rf "$CHROOT/etc/apt/sources.list" "$CHROOT/etc/calamares"
cat <<EOF >"$CHROOT/etc/apt/sources.list.d/ubuntu.sources"
Types: deb
URIs: $archive
Suites: resolute resolute-updates resolute-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: $security
Suites: resolute-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
EOF
EOS

desktop=/usr/share/applications/calamares-install-debian.desktop
sed -i -e 's/^Name=.*/Name=Install Amy OS/' -e 's/^Icon=.*/Icon=amyos/' "$desktop"
grep -qx 'Name=Install Amy OS' "$desktop"
